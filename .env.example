ANTHROPIC_API_KEY=sk-ant-...
PORT=3000
# 인터넷에 공개할 때 꼭 설정 (접속 비밀번호)
APP_PASSWORD=
# 응답 깊이: low(빠름, 통화용 권장) | medium | high
EFFORT=low
# (선택) 고음질 클라우드 음성 — 둘 다 없으면 브라우저 내장 음성으로 동작

# ElevenLabs — 귀여운/나긋한/속삭이는 등 캐릭터 목소리. elevenlabs.io → Profile → API Keys
# 사이트의 Voice Library 에서 "Add to my voices" 한 목소리가 앱 목록 맨 위에 ★로 나옴
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2   # 기본 eleven_v3 (속삭임 지시어 지원)

# 네이버 CLOVA Voice (Premium) — 네이버 클라우드 콘솔 > AI·NAVER API > Application 등록(CLOVA Voice 선택) 후 발급
CLOVA_CLIENT_ID=
CLOVA_CLIENT_SECRET=
# 화자 바꾸기 (콘솔 음성 목록의 speaker id:표시이름:느낌, 쉼표로 구분, 앞 4개가 ★추천)
# CLOVA_SPEAKERS=vyuna:유나:차분한,vgoeun:고은:따뜻한,vara:아라:다정한,nara:아라:부드러운

# Google Cloud Text-to-Speech API 키
GOOGLE_TTS_API_KEY=
